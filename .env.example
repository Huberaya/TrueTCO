# ───────── Serveur ─────────
NODE_ENV=development
PORT=3000
# Nombre de proxys de confiance devant l'app (1 derrière Vercel / Cloud Run / un load balancer). Impacte le rate limiting par IP.
TRUST_PROXY=0

# ───────── Base de données ─────────
# Connexion de l'APPLICATION : rôle truetco_app (NOBYPASSRLS). Voir docs/SECURITY.md §2.
DATABASE_URL=
# Connexion PROPRIÉTAIRE, réservée aux scripts (npm run db:migrate / admin:bootstrap). Jamais déployée avec le serveur.
MIGRATION_DATABASE_URL=
# true : le serveur REFUSE de démarrer si la connexion peut contourner le RLS (recommandé en production).
REQUIRE_RLS=false

# ───────── Authentification (Clerk) ─────────
# Clé secrète Clerk : vérifie la signature des jetons côté serveur. OBLIGATOIRE : il n'existe pas de mode sans authentification.
CLERK_SECRET_KEY=
# Origines autorisées à émettre des jetons (claim azp), séparées par des virgules. OBLIGATOIRE en production.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# Identifiants Clerk (user_...) des administrateurs de plateforme (métadonnées d'organisations uniquement).
PLATFORM_ADMIN_CLERK_IDS=
# Clé publique (frontend). Sans elle, l'interface démarre en MODE DÉMO local, sans aucun appel serveur.
VITE_CLERK_PUBLISHABLE_KEY=

# ───────── IA ─────────
GEMINI_API_KEY=
