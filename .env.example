# =============================================================================
# TrueTCO — Variables d'environnement
# -----------------------------------------------------------------------------
# Copiez ce fichier en `.env` et renseignez les valeurs. Aucune valeur secrète ne
# doit être commise dans le dépôt.
# =============================================================================

# -----------------------------------------------------------------------------
# Base de données (SOURCE DE VÉRITÉ — obligatoire)
# -----------------------------------------------------------------------------
# PostgreSQL 13 ou supérieur. Sans cette variable, le serveur REFUSE de démarrer :
# une application sans base perdrait silencieusement les données de l'utilisateur.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DB_NAME?sslmode=require

# Rôle applicatif soumis au RLS (créé par la migration 0002). Laisser la valeur
# par défaut sauf besoin spécifique. Chaîne vide = se connecter sans changement
# de rôle (déconseillé : les policies RLS ne protègent plus rien si le rôle de
# connexion est propriétaire des tables).
# TRUETCO_DB_APP_ROLE="truetco_app"
# TRUETCO_DB_SSL="true"

# Base PostgreSQL embarquée (PGlite) : TESTS UNIQUEMENT. Refusée en production.
# TRUETCO_USE_PGLITE="true"

# Applique les migrations au démarrage du serveur (utile en recette ; en
# production, préférez `npm run db:migrate` dans le pipeline de déploiement).
# TRUETCO_AUTO_MIGRATE="true"

# -----------------------------------------------------------------------------
# Authentification
# -----------------------------------------------------------------------------
# Mode de connexion. `local_demo` n'existe QUE pour les environnements de recette
# non exposés : il ne vérifie aucun mot de passe et ne remplace pas un vrai
# fournisseur d'identité.
# TRUETCO_AUTH_MODE="local_demo"
TRUETCO_ALLOW_DEMO_AUTH="false"

# Durée de vie des sessions (heures) et des invitations (heures).
# TRUETCO_SESSION_TTL_HOURS="12"
# TRUETCO_INVITATION_TTL_HOURS="168"

# -----------------------------------------------------------------------------
# Réseau et sécurité
# -----------------------------------------------------------------------------
# Origines autorisées pour les appels d'API (CORS) et pour les requêtes mutantes
# authentifiées par cookie (protection CSRF). Liste séparée par des virgules.
# Par défaut : AUCUNE origine tierce.
TRUETCO_ALLOWED_ORIGINS=""

# Port d'écoute du serveur d'API.
# PORT="3000"

# Adresse du serveur d'API utilisée par le serveur de développement Vite (proxy).
# TRUETCO_API_URL="http://127.0.0.1:3000"

# -----------------------------------------------------------------------------
# Versions de calcul (reproductibilité)
# -----------------------------------------------------------------------------
# La version moteur vient exclusivement de TCO_ENGINE_VERSION dans le code
# (2.1.0) : aucun override ne doit la faire diverger des décisions persistées.
# La version méthodologique est enregistrée avec chaque exécution de décision.
TRUETCO_METHODOLOGY_VERSION="2026.2"

# -----------------------------------------------------------------------------
# Fonctionnalités NON implémentées — ne pas activer par anticipation
# -----------------------------------------------------------------------------
# Connecteurs ERP : aucun connecteur réel n'existe (les routes répondent 501).
TRUETCO_ENABLE_SYNTHETIC_CONNECTORS="false"

# Fournisseur de modèle pour l'extraction documentaire : non intégré (route 501).
# GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# NOTE HISTORIQUE
# -----------------------------------------------------------------------------
# Clerk n'est plus utilisé : l'authentification est assurée côté serveur, avec des
# sessions révocables dont le jeton n'est jamais exposé au JavaScript de la page
# (cookie HttpOnly). Toute configuration Clerk résiduelle est sans effet.
