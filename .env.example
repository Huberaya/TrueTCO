# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# NEON (PostgreSQL Serverless)
# =============================================================================
# Chaîne de connexion PostgreSQL disponible dans la console Neon (Dashboard > Connection Details).
# Format : postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Dedicated least-privilege runtime role (truetco_app). Do not reuse DATABASE_URL.
# Required only when the server-side tenant SQL adapter is explicitly wired.
# Keep this value encrypted in the deployment platform; never commit a real URL.
DATABASE_URL_RUNTIME="postgresql://truetco_app:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# CLERK (Authentification & Gestion des Utilisateurs)
# =============================================================================
# Clé publique pour l'application frontend React (Clerk Dashboard > API Keys).
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample123456789"

# Clé secrète pour les vérifications côté serveur / middleware API (Clerk Dashboard > API Keys).
CLERK_SECRET_KEY="sk_test_sample123456789"

# Origines exactes autorisées pour les sessions Clerk (séparées par des virgules).
# Remplacer par les origines approuvées dans chaque environnement; pas de wildcard.
CLERK_AUTHORIZED_PARTIES="http://localhost:3000"

# Audience claim(s) expected in Clerk session JWTs. Configure the same value in the
# Clerk JWT template before enabling any protected route; this is not a secret.
CLERK_JWT_AUDIENCE="truetco-api"
