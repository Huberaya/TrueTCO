# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =============================================================================
# NEON (PostgreSQL Serverless)
# =============================================================================
# Chaîne de connexion PostgreSQL disponible dans la console Neon (Dashboard > Connection Details).
# Format : postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# =============================================================================
# CLERK (Authentification & Gestion des Utilisateurs)
# =============================================================================
# Clé publique pour l'application frontend React (Clerk Dashboard > API Keys).
VITE_CLERK_PUBLISHABLE_KEY="pk_test_sample123456789"

# Clé secrète pour les vérifications côté serveur / middleware API (Clerk Dashboard > API Keys).
CLERK_SECRET_KEY="sk_test_sample123456789"

# =============================================================================
# SÉCURITÉ & AUTHENTIFICATION (v2)
# =============================================================================
# Autorise la session de démonstration (email → session, SANS fournisseur
# d'identité). INTERDIT en production : le serveur refuse de démarrer si cette
# variable vaut « true » avec NODE_ENV=production.
TRUETCO_ALLOW_DEMO_AUTH="false"

# Origines autorisées pour les appels API inter-domaines (liste séparée par des
# virgules). Vide = même origine uniquement (recommandé).
TRUETCO_ALLOWED_ORIGINS=""

# Autorise les connecteurs ERP SIMULÉS (aucune connexion réelle). Les données
# renvoyées sont alors étiquetées `synthetic: true`. À laisser sur « false »
# hors démonstration commerciale.
TRUETCO_ENABLE_SYNTHETIC_CONNECTORS="false"

# Clé d'API du moteur d'extraction documentaire. Sans elle, l'endpoint
# /api/ai/parse-document répond 503 et n'invente AUCUNE donnée.
GEMINI_API_KEY=""

# -----------------------------------------------------------------------------
# NOTE : les variables Clerk ne sont PLUS utilisées (aucun fournisseur d'identité
# n'est branché). L'authentification cible repose sur un IdP OIDC/SAML côté
# serveur. Voir README (section Authentification) et le rapport d'audit.
# -----------------------------------------------------------------------------
