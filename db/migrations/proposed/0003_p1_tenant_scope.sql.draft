-- P1 DRAFT ONLY — tenant columns, composite constraints and RLS preparation.
-- Not included in Drizzle's executable migrations or any deployment command.
-- Before any future reviewed conversion: re-introspect the exact target, restore-test
-- backup, review lock/runtime impact, reconcile historical creator/audit mismatches,
-- and agree on explicit organization mappings/backfills for tenant-child rows.
-- Nullable child organization columns intentionally remain nullable in this phase;
-- RLS hides unscoped legacy rows. This is not a completed tenant activation.
-- Never run against Neon, staging, or production from this checkout.
BEGIN;
DO $$
BEGIN
  IF EXISTS (
    SELECT 1 FROM users WHERE clerk_id IS NOT NULL GROUP BY clerk_id HAVING count(*) > 1
  ) THEN
    RAISE EXCEPTION 'P1 preflight: duplicate non-NULL users.clerk_id values require manual resolution';
  END IF;
  IF EXISTS (
    SELECT 1 FROM supplier_offers o
    JOIN projects p ON p.id = o.project_id
    JOIN suppliers s ON s.id = o.supplier_id
    WHERE p.organization_id <> s.organization_id
  ) THEN
    RAISE EXCEPTION 'P1 preflight: offer project and supplier belong to different organizations';
  END IF;
  IF EXISTS (
    SELECT 1 FROM projects p JOIN users u ON u.id = p.created_by_user_id
    WHERE p.organization_id <> u.organization_id
  ) THEN
    RAISE EXCEPTION 'P1 preflight: project creator belongs to another organization';
  END IF;
  IF EXISTS (
    SELECT 1 FROM audit_logs a JOIN users u ON u.id = a.user_id
    WHERE a.organization_id <> u.organization_id
  ) THEN
    RAISE EXCEPTION 'P1 preflight: audit user belongs to another organization';
  END IF;
  IF EXISTS (
    SELECT 1 FROM audit_logs a JOIN projects p ON p.id = a.project_id
    WHERE a.organization_id <> p.organization_id
  ) THEN
    RAISE EXCEPTION 'P1 preflight: audit project belongs to another organization';
  END IF;
  IF to_regclass('public.user_sessions') IS NOT NULL AND EXISTS (
    SELECT 1 FROM public.user_sessions us JOIN public.users u ON u.id = us.user_id
    WHERE us.organization_id <> u.organization_id
  ) THEN
    RAISE EXCEPTION 'P1 preflight: session user belongs to another organization';
  END IF;
END $;
