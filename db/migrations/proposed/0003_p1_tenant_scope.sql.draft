DO $$
BEGIN
  IF to_regclass('public.user_sessions') IS NOT NULL
     AND NOT EXISTS (SELECT 1 FROM pg_policies WHERE schemaname = 'public' AND tablename = 'user_sessions' AND policyname = 'user_sessions_tenant_scope') THEN
    EXECUTE $policy$
      CREATE POLICY user_sessions_tenant_scope ON public.user_sessions
        USING (organization_id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid)
        WITH CHECK (organization_id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid)
    $policy$;
  END IF;
END $$;
