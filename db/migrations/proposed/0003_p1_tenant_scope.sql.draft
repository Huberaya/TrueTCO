DO $$
DECLARE target_table text;
BEGIN
  FOREACH target_table IN ARRAY ARRAY[
    'organizations', 'users', 'projects', 'suppliers', 'supplier_offers',
    'cost_items', 'carbon_items', 'risk_items', 'reference_benchmarks', 'audit_logs'
  ] LOOP
    EXECUTE format('ALTER TABLE %I ENABLE ROW LEVEL SECURITY', target_table);
    EXECUTE format('ALTER TABLE %I FORCE ROW LEVEL SECURITY', target_table);
  END LOOP;
END $$;
--> statement-breakpoint
-- user_sessions exists in the inspected Neon database but is absent from the
-- canonical P0 baseline/schema. Protect it when present without making a fresh
-- database migration fail because the legacy table does not exist. Its legacy
-- single-column user FK is not tenant-safe, so add a composite tenant FK too.
DO $
BEGIN
  IF to_regclass('public.user_sessions') IS NOT NULL THEN
    EXECUTE 'ALTER TABLE public.user_sessions ENABLE ROW LEVEL SECURITY';
    EXECUTE 'ALTER TABLE public.user_sessions FORCE ROW LEVEL SECURITY';
    IF NOT EXISTS (
      SELECT 1 FROM pg_constraint
      WHERE conrelid = 'public.user_sessions'::regclass
        AND conname = 'fk_user_sessions_user_tenant'
    ) THEN
      EXECUTE 'ALTER TABLE public.user_sessions ADD CONSTRAINT fk_user_sessions_user_tenant FOREIGN KEY (organization_id, user_id) REFERENCES public.users (organization_id, id)';
    END IF;
  END IF;
END $;
--> statement-breakpoint
CREATE POLICY organizations_tenant_scope ON organizations
  USING (id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid)
  WITH CHECK (id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid);
--> statement-breakpoint
CREATE POLICY users_tenant_scope ON users
  USING (
    organization_id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid
    OR (NULLIF(current_setting('true_tco.organization_id', true), '') IS NULL
        AND clerk_id = NULLIF(current_setting('true_tco.clerk_user_id', true), ''))
  )
  WITH CHECK (organization_id = NULLIF(current_setting('true_tco.organization_id', true), '')::uuid);
