{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node --loader tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "biome lint src server.ts vite.config.ts",
    "db:migrate": "node scripts/migrate-neon.mjs",
    "db:push": "drizzle-kit push --config=src/db/drizzle.config.ts",
    "test": "tsx --test src/engine/tcoEngine.node.test.ts src/services/safetyP0.test.ts src/server/safetyRoutes.test.ts src/server/apiGate.test.ts",
    "typecheck": "tsc --noEmit",
    "test:p0": "tsx --test src/services/safetyP0.test.ts src/server/safetyRoutes.test.ts src/server/apiGate.test.ts"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "@google/genai": "^2.4.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
