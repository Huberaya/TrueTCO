{
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": {
    "includes": ["src/**/*.{ts,tsx}", "server.ts", "vite.config.ts"]
  },
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "correctness": {
        "noUnusedImports": "error",
        "noUnreachable": "error"
      },
      "suspicious": {
        "noDebugger": "error"
      }
    }
  }
}
